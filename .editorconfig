# EditorConfig is awesome: http://EditorConfig.org
# All EditorConfig equals: https://github.com/reyesoft/ci/

root = true

[*]
charset = utf-8
indent_style = space
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true
end_of_line = lf

[*.{md,markdown}]
trim_trailing_whitespace = false

[*.{yml,yaml}]
indent_size = 2

[*.{json,jsonc}]
indent_size = 2

[*.{xml,plist}]
indent_size = 4

[*.{py}]
indent_size = 4

[*.{sh,bash}]
indent_size = 4
